# Публичный адрес сайта (без слэша на конце). Используется для canonical, OG и return_url ЮKassa.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL. Для локальной разработки подойдёт любой инстанс, например docker:
# docker run --name cofandr-db -e POSTGRES_PASSWORD=postgres -p 5433:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cofandr?schema=public"

# ЮKassa: https://yookassa.ru/developers/using-api/interaction-format#auth
# Тестовый магазин: https://yookassa.ru/developers/payment-acceptance/testing-and-going-live/testing
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
